{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/seagull_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/seagull_hook.py\"",
            "statusMessage": "seagull",
            "timeout": 30,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/seagull_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/seagull_hook.py\"",
            "statusMessage": "seagull",
            "timeout": 15,
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
